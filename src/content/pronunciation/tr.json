  {
    "title": "Two-way endings use e or a to match the word",
    "body": "This is vowel harmony: endings copy the type of the last vowel. After e, i, ö, ü you hear e (evler, evde); after a, ı, o, u you hear a (kızlar, okulda). The ending sounds like part of the word, not a separate piece.",
    "pattern": "(?<=\\p{L}{2})l[ae]r|(?<=\\p{L}{2}[^\\P{L}pçtkfhsş])d[ae]n?(?!\\p{L})|(?<=\\p{L}{2}[pçtkfhsş])(?<!(?<!\\p{L})(?:haf|hat))t[ae]n?(?!\\p{L})",
    "examples": [
      {
        "word": "evler",
        "say": "ev-LER",
        "en": "houses"
      },
      {
        "word": "kızlar",
        "say": "kuhz-LAHR",
        "en": "girls"
      },
      {
        "word": "evde",
        "say": "ev-DEH",
        "en": "at home"
      },
      {
        "word": "okulda",
        "say": "oh-kool-DAH",
        "en": "at school"
      }
    ]
  },
