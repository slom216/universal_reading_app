  {
    "title": "Stress usually falls on the last syllable",
    "body": "Most words are stressed lightly on the final syllable, and the stress moves along as endings are added: ev, evler “ev-LER”, evlerde “ev-ler-DEH”. Turkish stress is gentle, and unstressed vowels keep their full sound.",
    "pattern": "(?<!\\p{L})[^\\P{L}aeıioöuüâîû]*[aeıioöuüâîû]+[^\\P{L}aeıioöuüâîû]+[aeıioöuüâîû]\\p{L}*",
    "examples": [
      {
        "word": "güzel",
        "say": "gü-ZEL",
        "en": "beautiful"
      },
      {
        "word": "arkadaş",
        "say": "ahr-kah-DAHSH",
        "en": "friend"
      },
      {
        "word": "evlerde",
        "say": "ev-ler-DEH",
        "en": "in the houses"
      },
      {
        "word": "kitaplar",
        "say": "kee-tahp-LAHR",
        "en": "books"
      }
    ]
  },
