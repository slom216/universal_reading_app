  {
    "title": "Write as you speak, read as it is written",
    "body": "Each Serbian letter stands for one sound, in Cyrillic and Latin alike, and every letter is pronounced: no silent letters, no letter changing its sound by position. Unstressed vowels are never weakened to “uh”.",
    "pattern": "\\p{L}",
    "examples": [
      {
        "word": "вода (voda)",
        "say": "VO-da",
        "en": "water"
      },
      {
        "word": "хлеб (hleb)",
        "say": "khleb",
        "en": "bread"
      },
      {
        "word": "школа (škola)",
        "say": "SHKO-la",
        "en": "school"
      },
      {
        "word": "књига (knjiga)",
        "say": "KNYEE-ga",
        "en": "book"
      }
    ]
