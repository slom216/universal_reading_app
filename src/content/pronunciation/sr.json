  {
    "title": "Pitch and vowel length exist but are optional for learners",
    "body": "A stressed syllable has a rising or a falling pitch, and some vowels are long, but none of this is written. You will be understood if you just stress the right syllable. One useful fact: when the stress is not on the first syllable, the pitch is always rising.",
    "pattern": "(?<!\\p{L})\\p{L}*[аеиоу]\\p{L}*",
    "examples": [
      {
        "word": "кућа (kuća)",
        "say": "KOO-cha, falling",
        "en": "house"
      },
      {
        "word": "мама (mama)",
        "say": "MA-ma, falling",
        "en": "mom"
      },
      {
        "word": "вода (voda)",
        "say": "VO-da, rising",
        "en": "water"
      },
      {
        "word": "жена (žena)",
        "say": "ZHE-na, rising",
        "en": "woman, wife"
      }
    ]
  },
