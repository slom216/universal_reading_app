  {
    "title": "Every character is one syllable",
    "body": "Each Chinese character is read as exactly one syllable with its own tone. Words are often two or more characters, written with no spaces between words.",
    "pattern": "\\p{sc=Han}",
    "examples": [
      {
        "word": "我 (wǒ)",
        "say": "waw, dipping",
        "en": "I"
      },
      {
        "word": "中国 (Zhōngguó)",
        "say": "joong-GWAW, high + rising",
        "en": "China"
      },
      {
        "word": "学生 (xuésheng)",
        "say": "SHÜEH-shung, rising + neutral",
        "en": "student"
      }
    ]
  },
  {
    "title": "Tone 4 (à) falls sharply",
    "body": "The fourth tone starts high and drops fast to the bottom, like a firm “No!”.",
