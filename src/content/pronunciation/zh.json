        "say": "shr, falling",
        "en": "to be"
      },
      {
        "word": "去 (qù)",
        "say": "chü, falling",
        "en": "to go"
      },
      {
        "word": "大 (dà)",
        "say": "dah, falling",
        "en": "big"
      },
      {
        "word": "对 (duì)",
        "say": "dway, falling",
        "en": "correct"
      }
    ]
  },
