[
  {
    "title": "b, d, f, g, k, l, m, n, p, t, x sound as in English",
    "body": "These letters sound roughly as in English. g is always hard as in “go” (except French words like Garage, with “zh”), and l is always clear as in “leaf”, never the dark l of “full”.",
    "pattern": "[fklmnptx]|[bd](?=[aeiouäöüylr])|(?<!n)g(?=[aeiouäöüylr])",
    "examples": [
      {
        "word": "geben",
        "say": "GAY-buhn",
        "en": "to give"
      },
      {
        "word": "kalt",
        "say": "kalt",
        "en": "cold"
      },
      {
        "word": "der Text",
        "say": "dare text",
        "en": "text"
      },
      {
        "word": "der Film",
        "say": "dare film",
        "en": "film"
      }
    ]
  },
  {
    "title": "Most words stress the first syllable",
    "body": "German usually stresses the first syllable, and in compounds the first part. Separable prefixes such as an-, auf-, aus-, ein-, mit- take the stress too. The exceptions are a few unstressed prefixes and many loanwords (see those rules).",
    "pattern": "(?<!\\p{L})[^\\P{L}aeiouäöüy]*[aeiouäöüy]+[^\\P{L}aeiouäöüy]+[aeiouäöüy]",
    "examples": [
      {
        "word": "der Bahnhof",
        "say": "dare BAHN-hohf",
        "en": "station"
      },
      {
        "word": "arbeiten",
        "say": "AR-bye-tuhn",
        "en": "to work"
      },
      {
        "word": "anrufen",
        "say": "AN-roo-fuhn",
        "en": "to call"
      },
      {
        "word": "das Wochenende",
        "say": "dass VO-khuhn-en-duh",
        "en": "weekend"
      }
    ]
  },
  {
    "title": "a is always an open “ah”",
    "body": "a is the “a” of “father”: long when the vowel is long, the same sound said quickly when it is short. It is never the “a” of “cat” or “late”.",
    "pattern": "(?<!a)a(?![aiuy])",
    "examples": [
      {
        "word": "machen",
        "say": "MA-khuhn",
        "en": "to make, to do"
      },
      {
        "word": "danke",
        "say": "DAN-kuh",
        "en": "thanks"
      },
      {
        "word": "der Mann",
        "say": "dare man",
        "en": "man"
      },
      {
        "word": "der Abend",
        "say": "dare AH-buhnt",
        "en": "evening"
      }
    ]
  },
  {
    "title": "A vowel before one consonant and a vowel is long",
    "body": "A vowel followed by a single consonant and then another vowel is usually long. Short words ending in one consonant vary: gut and Tag are long, but mit, das, in, an and um are short.",
    "pattern": "[aeiouäöü](?=[bdfgklmnprstvwzß][aeiouäöüy])",
    "examples": [
      {
        "word": "der Name",
        "say": "dare NAH-muh",
        "en": "name"
      },
      {
        "word": "leben",
        "say": "LAY-buhn",
        "en": "to live"
      },
      {
        "word": "der Ofen",
        "say": "dare OH-fuhn",
        "en": "oven"
      },
      {
        "word": "sagen",
        "say": "ZAH-guhn",
        "en": "to say"
      }
    ]
  },
  {
    "title": "r after a vowel melts into a soft “uh”",
    "body": "When r follows a vowel and no vowel comes after it, it is not a real r: it becomes a soft “uh” or just lengthens the vowel. In Austria and the south you may hear a light r instead.",
    "pattern": "(?<=[aeiouäöüy]h?)r(?![aeiouäöüyr])",
    "examples": [
      {
        "word": "hier",
        "say": "hee-uh",
        "en": "here"
      },
      {
        "word": "vier",
        "say": "fee-uh",
        "en": "four"
      },
      {
        "word": "die Uhr",
        "say": "dee oo-uh",
        "en": "clock, o'clock"
      },
      {
        "word": "sehr",
        "say": "zay-uh",
        "en": "very"
      }
    ]
  },
  {
    "title": "A word starting with a vowel begins with a small catch",
    "body": "German doesn't run words together. A word that starts with a vowel begins with a tiny catch in the throat, as in “uh-oh”, so am Abend is not “a-mabend”. The same happens after a prefix inside a word.",
    "pattern": "(?<=\\p{L} )[aeiouäöü]",
    "examples": [
      {
        "word": "am Abend",
        "say": "am AH-buhnt",
        "en": "in the evening"
      },
      {
        "word": "ich esse",
        "say": "ikh ES-uh",
        "en": "I eat"
      },
      {
        "word": "beantworten",
        "say": "buh-ANT-vor-tuhn",
        "en": "to answer"
      },
      {
        "word": "der Verein",
        "say": "dare fair-INE",
        "en": "club"
      }
    ]
  },
  {
    "title": "Stressed e is “ay” when long, “e” in “bed” when short",
    "body": "Long e is like “ay” in “say”, but pure, without the glide to “ee”. Short e is like the “e” in “bed”. Unstressed e in endings and prefixes is a weak “uh”.",
    "pattern": "(?<![ie])e(?![iuey]|[lmnrst]?(?!\\p{L}))",
    "examples": [
      {
        "word": "der Weg",
        "say": "dare vayk",
        "en": "way, path"
      },
      {
        "word": "lesen",
        "say": "LAY-zuhn",
        "en": "to read"
      },
      {
        "word": "sehen",
        "say": "ZAY-uhn",
        "en": "to see"
      },
      {
        "word": "gestern",
        "say": "GES-tuhn",
        "en": "yesterday"
      }
    ]
  },
  {
    "title": "i is “ee” when long, “i” in “bit” when short",
    "body": "Long i (often written ie or ih) is the “ee” of “see”. Short i, before two consonants or in small words, is the “i” of “bit”. It is never the “eye” of English “mine”.",
    "pattern": "(?<![ae])i(?!e)",
    "examples": [
      {
        "word": "mit",
        "say": "mit",
        "en": "with"
      },
      {
        "word": "bis",
        "say": "bis",
        "en": "until"
      },
      {
        "word": "das Kino",
        "say": "dass KEE-noh",
        "en": "cinema"
      },
      {
        "word": "die Minute",
        "say": "dee mee-NOO-tuh",
        "en": "minute"
      }
    ]
  },
  {
    "title": "Unstressed -en, -el, -em, -es, -et have a weak “uh”",
    "body": "In these unstressed endings the e is a weak “uh”. In everyday speech -en is often reduced to a plain “n”, so haben sounds close to “HAH-bn”.",
    "pattern": "(?<=\\p{L}{2})(?<![ie])e[nlmst](?!\\p{L})",
    "examples": [
      {
        "word": "haben",
        "say": "HAH-buhn",
        "en": "to have"
      },
      {
