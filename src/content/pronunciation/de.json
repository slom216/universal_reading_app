    "pattern": "(?<!\\p{L})(?:be|ge|ver|zer|ent|emp|er)(?=\\p{L}{3})(?!i|hen|ben|stern|rn|gen(?!\\p{L})|sser|st(?:e[nrs]?)?(?!\\p{L})|de|nst)",
    "examples": [
