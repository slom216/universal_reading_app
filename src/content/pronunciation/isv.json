  {
    "title": "r is rolled",
    "body": "r is a rolled or tapped r made with the tip of the tongue, as in Spanish or Scottish English. Always pronounce it, also before consonants and at the end of a word.",
    "pattern": "(?<![bcčćdđfghjklmnpsštvzž])r|r(?=[aeiouyě])",
    "examples": [
      {
        "word": "raz",
        "say": "raz",
        "en": "once, time"
      },
      {
        "word": "rabota",
        "say": "ra-BO-ta",
        "en": "work"
      },
      {
        "word": "dobro",
        "say": "DO-bro",
        "en": "well, good"
      },
      {
        "word": "tri",
        "say": "tree",
        "en": "three"
      }
    ]
  },
  {
