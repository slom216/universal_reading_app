        "en": "help"
      },
      {
        "word": "srěćny",
        "say": "SRYECH-nih",
        "en": "happy, lucky"
      }
    ]
  },
  {
    "title": "A short “uh” may ease a hard final consonant cluster",
    "body": "Where a word ends in a consonant plus l, m or n, you may slip in a short “uh” to make it easier: jesm can be “YE-suhm”. Saying it as written is equally correct.",
    "pattern": "(?<=\\p{L}[bcčćdđfghkpsštvzž])[lmn](?!\\p{L})",
    "examples": [
      {
        "word": "jesm",
        "say": "yesm (or YE-suhm)",
        "en": "I am"
      },
      {
        "word": "mogl",
        "say": "mogl (or MO-guhl)",
        "en": "he could"
      },
      {
        "word": "sedm",
        "say": "sedm (or SE-duhm)",
        "en": "seven"
      },
      {
        "word": "osm",
        "say": "osm (or O-suhm)",
        "en": "eight"
      }
    ]
  },
