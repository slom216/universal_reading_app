[
  {
    "title": "b, d, f, k, l, m, n, p, s, t, v, z sound as in English",
    "body": "These letters are close to English, but p, t and k have no puff of air after them, and s is always “s” as in “spin”, never “z”.",
    "pattern": "[bfkmpstvz]|d(?!ž)|l(?!j)|n(?!j)",
    "examples": [
      {
        "word": "brat",
        "say": "brat",
        "en": "brother"
      },
      {
        "word": "tam",
        "say": "tam",
        "en": "there"
      },
      {
        "word": "zdravo",
        "say": "ZDRA-vo",
        "en": "hello"
      },
      {
        "word": "kafe",
        "say": "KA-feh",
        "en": "café"
      }
    ]
  },
  {
    "title": "Stress is free; two-syllable words are safest on the first",
    "body": "Interslavic has no fixed stress and any Slavic habit is accepted. Safe guide: two syllables, stress the first; three, the first or second; four, the second or third. Keep the stress on the same syllable when endings change (běly “BYE-lih”, bělogo “BYE-lo-go”) and avoid stressing endings.",
    "pattern": "(?<!\\p{L})\\p{L}*?[aeiouyě]+[^aeiouyě\\P{L}]+[aeiouyě]\\p{L}*",
    "examples": [
      {
        "word": "voda",
        "say": "VO-da",
        "en": "water"
      },
      {
        "word": "sestra",
        "say": "SES-tra",
        "en": "sister"
      },
      {
        "word": "rabota",
        "say": "ra-BO-ta",
        "en": "work"
      },
      {
        "word": "govoriti",
        "say": "go-vo-REE-tee",
        "en": "to speak"
      }
    ]
  },
  {
    "title": "a sounds like “a” in “father”",
    "body": "a is an open “a”, never the “a” of “cat” or “late”. Every vowel keeps its full sound in unstressed syllables too.",
    "pattern": "a",
    "examples": [
      {
        "word": "mama",
        "say": "MA-ma",
        "en": "mum"
      },
      {
        "word": "na",
        "say": "na",
        "en": "on"
      },
      {
        "word": "kava",
        "say": "KA-va",
        "en": "coffee"
      },
      {
        "word": "grad",
        "say": "grad",
        "en": "city"
      }
    ]
  },
  {
    "title": "o sounds like “o” in “or”, also when unstressed",
    "body": "o is an open “o”, never the “oh” glide of English “go”. Keep it an “o” in unstressed syllables too; do not turn it into “a” as in Russian.",
    "pattern": "o",
    "examples": [
      {
        "word": "ona",
        "say": "O-na",
        "en": "she"
      },
      {
        "word": "dom",
        "say": "dom",
        "en": "house"
      },
      {
        "word": "doma",
        "say": "DO-ma",
        "en": "at home"
      },
      {
        "word": "mnogo",
        "say": "MNO-go",
        "en": "much, many"
      }
    ]
  },
  {
    "title": "i sounds like “ee” in “beat”",
    "body": "i is a clear “ee”, a little shorter than in English.",
    "pattern": "i",
