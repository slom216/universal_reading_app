 "406": "كُلَّ يَوْمٍ.",
 "407": "يَوْمَ الِاثْنَيْنِ.",
 "408": "فِي عُطْلَةِ نِهَايَةِ الْأُسْبُوعِ.",
 "409": "تَأَخَّرْتَ.",
 "410": "فِي أَيِّ سَاعَةٍ نَلْتَقِي؟",
 "411": "لِنَلْتَقِ فِي [الْوَقْت].",
 "412": "هَلْ يُنَاسِبُكَ ذٰلِكَ؟",
 "413": "أَنَا مُتَفَرِّغٌ (مُتَفَرِّغَةٌ) غَدًا.",
 "414": "أَنَا مَشْغُولٌ (مَشْغُولَةٌ) الْيَوْمَ.",
 "415": "كَيْفَ الطَّقْسُ؟",
 "416": "الْجَوُّ حَارٌّ.",
 "417": "الْجَوُّ بَارِدٌ.",
 "418": "السَّمَاءُ تُمْطِرُ.",
