 "245": "كَيْفَ الْأَحْوَالُ؟",
 "246": "لَا بَأْسَ.",
 "247": "بَيْنَ بَيْنَ.",
 "248": "لَمْ أَرَكَ مُنْذُ زَمَنٍ طَوِيلٍ.",
 "249": "أَرَاكَ قَرِيبًا.",
 "250": "اعْتَنِ بِنَفْسِكَ.",
 "251": "رِحْلَةً سَعِيدَةً!",
 "252": "عُطْلَةً سَعِيدَةً فِي نِهَايَةِ الْأُسْبُوعِ.",
 "253": "مَا رَقْمُ هَاتِفِكَ؟",
 "254": "رَقْمِي [الرَّقْم].",
 "256": "سِعْرُهُ [السِّعْر].",
 "257": "هَلْ يُمْكِنُكَ أَنْ تَكْتُبَ السِّعْرَ؟",
 "258": "مَا عُنْوَانُكَ؟",
 "259": "فِي أَيِّ طَابِقٍ؟",
 "260": "كَمْ شَخْصًا؟",
 "261": "شَخْصَانِ، مِنْ فَضْلِكَ.",
 "262": "أَتَفَرَّجُ فَقَطْ.",
 "263": "هَلْ يُمْكِنُنِي أَنْ أُجَرِّبَهُ؟",
 "264": "هَلْ عِنْدَكَ مَقَاسٌ أَكْبَرُ؟",
 "265": "هَلْ عِنْدَكَ مَقَاسٌ أَصْغَرُ؟",
 "266": "هَلْ عِنْدَكَ لَوْنٌ آخَرُ؟",
 "267": "سَآخُذُهُ.",
 "268": "هَلْ عِنْدَكَ كِيسٌ؟",
 "269": "هَلْ يُمْكِنُنِي أَنْ آخُذَ إِيصَالًا؟",
 "270": "هَلْ هُنَاكَ خَصْمٌ؟",
 "271": "أَيْنَ السُّوبَرْمَارْكِتُ؟",
 "272": "أَيْنَ أَقْرَبُ صَرَّافٍ آلِيٍّ؟",
 "273": "هَلْ يُمْكِنُنِي أَنْ أُرْجِعَ هٰذَا؟",
 "274": "أَيْنَ أَدْفَعُ؟",
 "275": "هَلْ تَقْبَلُونَ بِطَاقَاتِ الِائْتِمَانِ؟",
 "276": "إِنَّهُ هَدِيَّةٌ.",
 "277": "هَلْ يُمْكِنُكَ أَنْ تُرِيَنِي عَلَى الْخَرِيطَةِ؟",
 "278": "أَيْنَ نَحْنُ الْآنَ؟",
 "279": "مَا اسْمُ هٰذَا الشَّارِعِ؟",
 "280": "هَلْ يُمْكِنُكَ أَنْ تُرْسِلَ لِيَ الْمَوْقِعَ؟",
 "281": "هَلْ يُمْكِنُ الْوُصُولُ إِلَيْهِ مَشْيًا؟",
 "282": "كَمْ يَبْعُدُ؟",
 "283": "إِنَّهُ هُنَاكَ.",
 "284": "إِنَّهُ بَعْدَ الزَّاوِيَةِ.",
 "285": "إِنَّهُ بِجَانِبِ [الْمَكَان].",
 "286": "إِنَّهُ مُقَابِلَ [الْمَكَان].",
 "287": "فِي آخِرِ الشَّارِعِ.",
 "288": "خُذْ أَوَّلَ شَارِعٍ عَلَى الْيَسَارِ.",
 "289": "اعْبُرِ الشَّارِعَ.",
 "290": "أَيْنَ وَسَطُ الْمَدِينَةِ؟",
 "291": "هَلْ هٰذَا هُوَ الطَّرِيقُ الصَّحِيحُ إِلَى [الْمَكَان]؟",
 "292": "أَظُنُّ أَنَّنِي أَخْطَأْتُ الطَّرِيقَ.",
 "293": "أَيْنَ يُمْكِنُنِي أَنْ أَشْتَرِيَ تَذْكِرَةً؟",
 "294": "كَمْ سِعْرُ التَّذْكِرَةِ؟",
 "295": "مَتَى الْحَافِلَةُ الْقَادِمَةُ؟",
 "296": "مَتَى آخِرُ قِطَارٍ؟",
 "297": "هَلْ هٰذَا هُوَ الْقِطَارُ الذَّاهِبُ إِلَى [الْمَكَان]؟",
 "298": "هَلْ يَجِبُ أَنْ أُغَيِّرَ الْقِطَارَ؟",
 "299": "كَمْ مَحَطَّةً إِلَى هُنَاكَ؟",
 "300": "هَلْ يُمْكِنُكَ أَنْ تُخْبِرَنِي مَتَى أَنْزِلُ؟",
 "301": "أُرِيدُ أَنْ أَسْتَأْجِرَ سَيَّارَةً.",
 "302": "أَيْنَ مَحَطَّةُ الْوَقُودِ؟",
 "303": "أَيْنَ يُمْكِنُنِي أَنْ أَرْكُنَ السَّيَّارَةَ؟",
 "304": "هٰذَا جَوَازُ سَفَرِي.",
 "305": "لَيْسَ عِنْدِي مَا أُصَرِّحُ بِهِ.",
 "306": "أَيْنَ مَكَانُ اسْتِلَامِ الْأَمْتِعَةِ؟",
 "307": "ضَاعَتْ أَمْتِعَتِي.",
 "308": "أَيْنَ الْبَوَّابَةُ رَقْمُ [الرَّقْم]؟",
 "309": "مَتَى نَصْعَدُ إِلَى الطَّائِرَةِ؟",
 "310": "مَقْعَدًا بِجَانِبِ النَّافِذَةِ، مِنْ فَضْلِكَ.",
 "311": "هَلْ تَفْتَحُونَ الْآنَ؟",
 "312": "هَلْ عِنْدَكُمْ طَاوِلَةٌ فِي الْخَارِجِ؟",
 "313": "مَا هٰذَا الطَّبَقُ؟",
 "314": "لَمْ أَطْلُبْ هٰذَا.",
 "315": "هَلْ يُمْكِنُنِي أَنْ آخُذَ مَزِيدًا مِنَ الْخُبْزِ؟",
 "316": "بِدُونِ ثَلْجٍ، مِنْ فَضْلِكَ.",
 "317": "هَلْ يُمْكِنُنِي أَنْ أَرَى قَائِمَةَ النَّبِيذِ؟",
 "318": "شَبِعْتُ.",
 "319": "سَآخُذُهُ مَعِي، مِنْ فَضْلِكَ.",
 "320": "سَآكُلُ هُنَا، مِنْ فَضْلِكَ.",
 "321": "هَلْ مَاءُ الصُّنْبُورِ صَالِحٌ لِلشُّرْبِ؟",
 "322": "مَاءٌ غَازِيٌّ أَمْ عَادِيٌّ؟",
 "323": "زُجَاجَةَ مَاءٍ، مِنْ فَضْلِكَ.",
 "324": "لَا أَسْتَطِيعُ أَنْ آكُلَ [الطَّعَام].",
 "325": "عِنْدِي حَسَاسِيَّةٌ مِنَ الْمُكَسَّرَاتِ.",
 "326": "بِدُونِ [الْمُكَوِّن]، مِنْ فَضْلِكَ.",
 "327": "نَحْنُ جَاهِزُونَ لِلطَّلَبِ.",
 "328": "أُرِيدُ تَسْجِيلَ الدُّخُولِ.",
 "329": "هَلْ يُمْكِنُنِي تَسْجِيلُ الدُّخُولِ مُبَكِّرًا؟",
 "330": "أُرِيدُ تَسْجِيلَ الْمُغَادَرَةِ.",
 "331": "هَلْ يُمْكِنُنِي أَنْ أَرَى الْغُرْفَةَ؟",
 "332": "هَلْ يُوجَدُ مِصْعَدٌ؟",
 "333": "هَلْ يُوجَدُ مَدْخَلٌ بِدُونِ دَرَجٍ؟",
 "334": "هَلْ يُوجَدُ تَكْيِيفٌ؟",
 "335": "لَا يُوجَدُ مَاءٌ سَاخِنٌ.",
 "336": "هَلْ يُمْكِنُكُمْ تَنْظِيفُ الْغُرْفَةِ، مِنْ فَضْلِكَ؟",
 "337": "هَلْ يُمْكِنُنِي أَنْ آخُذَ مِنْشَفَةً أُخْرَى؟",
 "338": "هَلْ يُمْكِنُكَ أَنْ تَطْلُبَ لِي سَيَّارَةَ أُجْرَةٍ؟",
 "339": "الْغُرْفَةُ صَاخِبَةٌ جِدًّا.",
 "340": "أُرِيدُ أَنْ أَبْقَى لَيْلَةً أُخْرَى.",
 "341": "لَا أَشْعُرُ أَنَّنِي بِخَيْرٍ.",
