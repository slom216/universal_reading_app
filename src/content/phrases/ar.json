 "346": "ظَهْرِي يُؤْلِمُنِي.",
 "347": "عِنْدِي طَفْحٌ جِلْدِيٌّ.",
 "348": "أَحْتَاجُ إِلَى طَبِيبِ أَسْنَانٍ.",
 "349": "أَتَنَاوَلُ هٰذَا الدَّوَاءَ.",
 "350": "نَفِدَ دَوَائِي.",
 "351": "هَلْ أَحْتَاجُ إِلَى وَصْفَةٍ طِبِّيَّةٍ؟",
 "352": "عِنْدِي مَرَضُ السُّكَّرِيِّ.",
 "353": "أَنَا حَامِلٌ.",
 "354": "أَسْتَخْدِمُ كُرْسِيًّا مُتَحَرِّكًا.",
 "355": "سَمْعِي ضَعِيفٌ.",
 "356": "عِنْدِي تَأْمِينٌ صِحِّيٌّ.",
 "357": "كَمْ مَرَّةً يَجِبُ أَنْ أَتَنَاوَلَهُ؟",
 "358": "هَلْ يَجِبُ أَنْ أَتَنَاوَلَهُ مَعَ الطَّعَامِ؟",
 "359": "جَرَحْتُ نَفْسِي.",
 "361": "وَقَعَ حَادِثٌ.",
 "362": "الْعُنْوَانُ هُوَ [الْعُنْوَان].",
 "363": "أَشُمُّ رَائِحَةَ غَازٍ.",
 "364": "فَقَدْتُ مِحْفَظَتِي.",
 "365": "يَجِبُ أَنْ أُوقِفَ بِطَاقَتِي الْبَنْكِيَّةَ.",
 "366": "فَقَدْتُ هَاتِفِي.",
 "367": "أَيْنَ مَرْكَزُ الشُّرْطَةِ؟",
 "368": "هَلْ يُمْكِنُنِي أَنْ أَسْتَخْدِمَ هَاتِفَكَ؟",
 "369": "يَجِبُ أَنْ أَتَّصِلَ بِعَائِلَتِي.",
 "370": "ابْتَعِدْ عَنِّي!",
 "371": "هَلْ هٰذَا الْمَكَانُ آمِنٌ؟",
 "372": "هَلِ الْمَشْيُ هُنَا آمِنٌ فِي اللَّيْلِ؟",
 "373": "احْذَرْ!",
 "374": "أَنَا مُتَزَوِّجٌ (مُتَزَوِّجَةٌ).",
 "375": "أَنَا أَعْزَبُ (عَزْبَاءُ).",
 "376": "لَيْسَ عِنْدِي أَطْفَالٌ.",
 "377": "هٰذَا ابْنِي.",
 "378": "هٰذِهِ ابْنَتِي.",
 "379": "هٰذَانِ وَالِدَايَ.",
 "380": "عِنْدِي أَخٌ.",
 "381": "عِنْدِي أُخْتٌ.",
 "382": "أَيْنَ تَعْمَلُ؟",
 "383": "أَعْمَلُ فِي مَكْتَبٍ.",
 "384": "أَنَا مُتَقَاعِدٌ (مُتَقَاعِدَةٌ).",
 "385": "أَبْحَثُ عَنْ عَمَلٍ.",
 "386": "مَاذَا تَدْرُسُ؟",
