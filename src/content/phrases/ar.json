 "907": "سَامِحْنِي.",
 "908": "لَا بَأْسَ، سَامَحْتُكَ.",
 "909": "هَلْ يُمْكِنُنَا أَنْ نَتَكَلَّمَ؟",
 "910": "أُرِيدُ أَنْ أَقُولَ لَكَ شَيْئًا.",
 "911": "أَنَا أُصْغِي إِلَيْكَ.",
 "912": "شُكْرًا عَلَى الِاسْتِمَاعِ.",
 "913": "هَلْ تُحِبُّ أَنْ تَخْرُجَ مَعِي؟",
 "914": "هَلْ أَنْتَ مُتَفَرِّغٌ يَوْمَ [الْيَوْم]؟",
 "915": "قَضَيْتُ أُمْسِيَةً جَمِيلَةً.",
 "916": "هَلْ يُمْكِنُنِي أَنْ أَرَاكَ مَرَّةً أُخْرَى؟",
 "917": "كَيْفَ يَعْمَلُ هٰذَا؟",
 "918": "لَا يَعْمَلُ.",
 "919": "إِنَّهُ مَكْسُورٌ.",
 "920": "بَطَّارِيَّةُ هَاتِفِي فَارِغَةٌ.",
 "921": "هَلْ يُمْكِنُنِي أَنْ أَسْتَخْدِمَ شَاحِنَكَ؟",
 "922": "هَلْ يُمْكِنُكَ أَنْ تُرْسِلَ لِيَ الصُّورَةَ؟",
 "923": "سَأُرْسِلُ لَكَ رِسَالَةً.",
 "924": "هَلْ وَصَلَتْكَ رِسَالَتِي؟",
 "925": "لَمْ تَصِلْنِي رِسَالَتُكَ.",
 "926": "نَسِيتُ كَلِمَةَ السِّرِّ.",
 "927": "لَا أَسْتَطِيعُ تَسْجِيلَ الدُّخُولِ.",
 "928": "سَأُرْسِلُ لَكَ الرَّابِطَ.",
 "929": "هَلْ تَسْمَعُنِي الْآنَ؟",
 "930": "أَيْنَ أُوَقِّعُ؟",
 "931": "أَحْتَاجُ إِلَى وَقْتٍ لِأَقْرَأَ هٰذَا قَبْلَ التَّوْقِيعِ.",
 "932": "مَا الْوَثَائِقُ الَّتِي أَحْتَاجُ إِلَيْهَا؟",
 "933": "هَلْ يُمْكِنُنِي أَنْ أَفْعَلَ هٰذَا عَبْرَ الْإِنْتَرْنِتِ؟",
 "934": "أَحْتَاجُ إِلَى نُسْخَةٍ مِنْ هٰذَا.",
 "935": "هٰذِهِ بِطَاقَةُ هُوِيَّتِي.",
 "936": "أَيْنَ الْمَكْتَبُ؟",
 "937": "كَمْ تَسْتَغْرِقُ الْمُعَامَلَةُ؟",
 "938": "مَتَى سَيَكُونُ جَاهِزًا؟",
 "939": "أُرِيدُ أَنْ أُسَجِّلَ.",
 "940": "أُرِيدُ أَنْ أُقَدِّمَ طَلَبًا لِلْحُصُولِ عَلَى [الشَّيْء].",
 "941": "عِنْدِي مَوْعِدٌ.",
 "942": "جِئْتُ لِأَسْتَلِمَ [الشَّيْء].",
 "943": "مَنِ الْمَسْؤُولُ عَنْ هٰذَا؟",
 "944": "هَلْ يُمْكِنُنِي أَنْ أَتَكَلَّمَ مَعَ الْمُدِيرِ؟",
 "945": "أُرِيدُ أَنْ أُقَدِّمَ شَكْوَى.",
 "946": "مَا مَوَاعِيدُ الْعَمَلِ؟",
 "947": "أَيْنَ الْحَلَّاقُ؟",
 "948": "تَقْصِيرٌ خَفِيفٌ فَقَطْ، مِنْ فَضْلِكَ.",
 "949": "أُرِيدُ أَنْ أُرْسِلَ طَرْدًا.",
 "950": "كَمْ سِعْرُ الطَّابِعِ؟",
 "951": "أُرِيدُ أَنْ أُرْسِلَ هٰذَا بِالْبَرِيدِ.",
 "952": "أَيْنَ مَغْسَلَةُ الْمَلَابِسِ؟",
 "953": "كَمْ سَيُكَلِّفُ التَّصْلِيحُ؟",
 "954": "مَتَى يُمْكِنُنِي أَنْ أَسْتَلِمَهُ؟",
 "955": "هَلْ أَحْتَاجُ إِلَى مَوْعِدٍ؟",
 "956": "هَلْ يُمْكِنُنِي الْحَجْزُ عَبْرَ الْإِنْتَرْنِتِ؟",
 "957": "أُرِيدُ أَنْ أُلْغِيَ حَجْزِي.",
 "958": "أُرِيدُ أَنْ أُلْغِيَ هٰذَا الِاشْتِرَاكَ.",
 "959": "أُرِيدُ أَنْ أُغَيِّرَ حَجْزِي.",
 "960": "هَيَّا نَذْهَبْ إِلَى الْجِبَالِ.",
 "961": "إِلَى أَيْنَ يُؤَدِّي هٰذَا الطَّرِيقُ؟",
 "962": "هَلِ السِّبَاحَةُ آمِنَةٌ هُنَا؟",
 "963": "هَلْ يُمْكِنُنَا أَنْ نَسْبَحَ هُنَا؟",
 "964": "هَلْ يُمْكِنُنَا أَنْ نُخَيِّمَ هُنَا؟",
 "965": "يَا لَهُ مِنْ مَنْظَرٍ جَمِيلٍ!",
 "966": "هَلْ هُنَاكَ حَيَوَانَاتٌ خَطِيرَةٌ؟",
 "967": "مَا التَّقَالِيدُ هُنَا؟",
 "968": "هَلْ [النَّشَاط] مِنْ قِلَّةِ الْأَدَبِ هُنَا؟",
 "969": "مَاذَا يَجِبُ أَنْ أَلْبَسَ؟",
 "970": "هَلْ يُعْطِي النَّاسُ بَقْشِيشًا هُنَا؟",
 "971": "كَيْفَ يُسَلِّمُ النَّاسُ عَلَى بَعْضِهِمْ هُنَا؟",
 "972": "مَا الشَّيْءُ الْمُمَيَّزُ هُنَا؟",
 "973": "مَا الطَّبَقُ الْمَحَلِّيُّ؟",
 "974": "مَا الْمَشْرُوبُ الْمَحَلِّيُّ؟",
 "975": "هَلْ هُنَاكَ حَفْلَةٌ مُوسِيقِيَّةٌ اللَّيْلَةَ؟",
 "976": "أَيْنَ يُمْكِنُنِي أَنْ أَشْتَرِيَ تَذَاكِرَ لِلْعَرْضِ؟",
 "977": "مَتَى يَبْدَأُ الْعَرْضُ؟",
 "978": "أُحِبُّ بَلَدَكَ.",
 "979": "النَّاسُ هُنَا وَدُودُونَ جِدًّا.",
 "980": "أَنْتَ قَادِرٌ عَلَى ذٰلِكَ!",
 "981": "لَا تَسْتَسْلِمْ.",
 "982": "اسْتَمِرَّ.",
 "983": "أَنْتَ تُبْلِي بَلَاءً حَسَنًا.",
 "984": "أَنَا أُؤْمِنُ بِكَ.",
 "985": "سَيَكُونُ كُلُّ شَيْءٍ بِخَيْرٍ.",
 "986": "خُذْ وَقْتَكَ.",
 "987": "هٰذَا لَيْسَ ذَنْبَكَ.",
 "988": "هٰذَا يَحْدُثُ.",
 "989": "لَا تَخَفْ.",
 "990": "سُرِرْتُ بِالْحَدِيثِ مَعَكَ.",
 "991": "سُرِرْتُ بِلِقَائِكَ.",
 "992": "يَجِبُ أَنْ أُغَادِرَ الْآنَ.",
 "993": "شُكْرًا عَلَى كُلِّ شَيْءٍ.",
 "994": "سَلِّمْ لِي عَلَى عَائِلَتِكَ.",
 "995": "أَتَمَنَّى لَكَ عَوْدَةً سَالِمَةً إِلَى بَيْتِكَ.",
 "996": "تَعَالَ لِزِيَارَتِي.",
 "997": "سَأَشْتَاقُ إِلَيْكَ.",
 "998": "إِلَى اللِّقَاءِ.",
 "999": "أَتَمَنَّى لَكَ أُمْسِيَةً سَعِيدَةً.",
 "1000": "بِالتَّوْفِيقِ فِي كُلِّ شَيْءٍ.",
 "1001": "أَيْنَ أَنْتَ الْآنَ؟",
 "1002": "أُفَضِّلُ أَلَّا أُجِيبَ عَنْ هٰذَا.",
 "1003": "هَلْ هُنَاكَ رُسُومٌ إِضَافِيَّةٌ؟"
}
